# Vulcan environment variables
# Copy to `.env` for local docker compose: `cp .env.example .env`
# Values below are placeholders — fill in as each phase lands.

# =============================================================================
# Phase 0 — local stack (CPU-only)
# =============================================================================
# Never set CI or compose defaults to provision cloud GPU nodes (ADR-002).
VULCAN_ENV=local
VULCAN_RUNTIME_MODE=cpu

# Placeholder HTTP port for future serving/common CPU-dev process
VULCAN_SERVING_PORT=8080

# Compose project name
COMPOSE_PROJECT_NAME=vulcan

# =============================================================================
# Later phases — gateway / observability (stubs)
# =============================================================================
# VULCAN_GATEWAY_PORT=8090
# VULCAN_GRAFANA_PORT=3001
