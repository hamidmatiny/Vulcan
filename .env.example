# Vulcan environment variables
# Copy to `.env` for local docker compose: `cp .env.example .env`
#
# Host ports: Vulcan owns 9000–9099 only (avoid Argus / other stacks).

# =============================================================================
# Local stack (CPU-only; ADR-002)
# =============================================================================
VULCAN_ENV=local
VULCAN_RUNTIME_MODE=cpu
COMPOSE_PROJECT_NAME=vulcan

# 9000 — serving/bentoml
VULCAN_BENTOML_PORT=9000
# 9001 — serving/common reference server (compose profile: reference)
VULCAN_REFERENCE_PORT=9001
# 9002 — serving/ray-serve
VULCAN_RAY_SERVE_PORT=9002
# 9003 — serving/triton (contract shim)
VULCAN_TRITON_PORT=9003
# 9004 — serving/vllm (contract shim; LLM-only)
VULCAN_VLLM_PORT=9004
# 9007 — gateway (routing; ADR-006)
VULCAN_GATEWAY_PORT=9007
# 9008 — Prometheus
VULCAN_PROMETHEUS_PORT=9008
# 9009 — Grafana
VULCAN_GRAFANA_PORT=9009
# 9010 — Tempo (trace query API)
VULCAN_TEMPO_PORT=9010
# 9099 — optional OpenAPI stub (compose profile: stub)
VULCAN_STUB_PORT=9099

# Conformance suite target (default: bentoml; :9002 ray-serve / :9003 triton / :9004 vllm / :9007 gateway)
VULCAN_BACKEND_URL=http://127.0.0.1:9000
# LLM-only backends (vllm): VULCAN_CONFORMANCE_MODALITIES=llm
# VULCAN_CONFORMANCE_MODALITIES=llm,vision
