{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulcan.dev/schemas/benchmark-result.schema.json",
  "title": "VulcanBenchmarkResult",
  "description": "One load-test run against a contract-compliant backend. One file per backend (and modality) under benchmark/results/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend",
    "modality",
    "model_id",
    "target_url",
    "started_at",
    "duration_seconds",
    "vus",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "backend": {
      "type": "string",
      "minLength": 1,
      "description": "Backend identifier (reference, vllm, triton, …)."
    },
    "modality": {
      "type": "string",
      "enum": ["llm", "vision"]
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "target_url": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "vus": {
      "type": "integer",
      "minimum": 1
    },
    "runtime_mode": {
      "type": "string",
      "enum": ["cpu", "gpu"],
      "default": "cpu"
    },
    "notes": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_total",
        "error_rate",
        "throughput_rps",
        "latency_ms"
      ],
      "properties": {
        "requests_total": {
          "type": "integer",
          "minimum": 0
        },
        "error_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of failed requests (0–1)."
        },
        "throughput_rps": {
          "type": "number",
          "minimum": 0
        },
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p50", "p95", "p99"],
          "properties": {
            "p50": { "type": "number", "minimum": 0 },
            "p95": { "type": "number", "minimum": 0 },
            "p99": { "type": "number", "minimum": 0 },
            "avg": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
