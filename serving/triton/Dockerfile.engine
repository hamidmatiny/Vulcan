# Triton Inference Server — CPU model repository (ADR-002: no CUDA required).
# Build from repo root after `make triton-prepare` (ONNX under model_repository/*/1/):
#   docker build -f serving/triton/Dockerfile.engine -t vulcan-triton-engine:cpu .
#
# Official images are linux/amd64; on Apple Silicon use compose `platform: linux/amd64`.

FROM nvcr.io/nvidia/tritonserver:24.05-py3

ENV CUDA_VISIBLE_DEVICES=""

# Vendor image ships stale linux-libc-dev; Trivy CRITICAL gates on fixed CVEs in that package.
RUN apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade linux-libc-dev \
 && rm -rf /var/lib/apt/lists/*

COPY serving/triton/model_repository /models

# HTTP :8000, gRPC :8001, Prometheus metrics :8002 (internal compose network only).
EXPOSE 8000 8001 8002

HEALTHCHECK --interval=10s --timeout=5s --start-period=120s --retries=24 \
  CMD curl -fsS http://127.0.0.1:8000/v2/health/ready || exit 1

CMD ["tritonserver", \
     "--model-repository=/models", \
     "--http-port=8000", \
     "--grpc-port=8001", \
     "--metrics-port=8002", \
     "--allow-gpu-metrics=false", \
     "--strict-model-config=true", \
     "--log-verbose=0"]
