# Self-hosted MLflow tracking server (ADR-013). Built in compose/CI so we never
# depend on authenticated pulls from ghcr.io/mlflow/mlflow.
FROM python:3.12-slim-bookworm

RUN pip install --no-cache-dir "mlflow==2.22.5"

EXPOSE 9014

CMD [ \
  "mlflow", "server", \
  "--host", "0.0.0.0", \
  "--port", "9014", \
  "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
  "--default-artifact-root", "/mlflow/artifacts" \
]
